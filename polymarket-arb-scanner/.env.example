# Polymarket Arbitrage Scanner - conservative defaults
# Copy to .env and adjust only after you understand the scan budget / quote budget tradeoff.

# API Endpoints
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CLOB_API_URL=https://clob.polymarket.com
# POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
# COMBO_RFQ_API_URL=https://combos-rfq-api.polymarket.sh
# PREDICTION_MARKET_SOURCES=polymarket,kalshi,manifold,seer,sxbet
# KALSHI_API_URL=https://external-api.kalshi.com/trade-api/v2
# MANIFOLD_API_URL=https://api.manifold.markets/v0
# PREDICTIT_API_URL=https://www.predictit.org/api/marketdata/all/
# LIMITLESS_API_URL=https://api.limitless.exchange
# Limitless discovery is scan-only and admits only explicit Polymarket mirrors
# backed by current CLOB order-book depth; it never auto-pairs titles for trade.
# SEER_API_URL=https://app.seer.pm/.netlify/functions
# SXBET_API_URL=https://api.sx.bet
# SXBET_BASE_TOKEN=
# BETDEX_API_URL=https://prod.api.btdx.io
# BETDEX_AUTH_TOKEN=
# Credential-gated, latency-heavy, or depth-limited adapters are opt-in; append
# `limitless,predictit,betdex` only for isolated research scans. Use
# cross_venue_shadow.py for paired Limitless/Polymarket observations.

# Scanner behaviour
# CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# CLOB_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
SCAN_INTERVAL_SECONDS=1
DISCOVERY_INTERVAL_SECONDS=30
MAX_EVENTS_TO_FETCH=500
MIN_LIQUIDITY_USD=1000
MIN_NET_PROFIT_USD=1.00
MIN_ROI_PCT=1.00
API_TIMEOUT_SECONDS=15
USE_CLOB_PRICES=true
USE_WEBSOCKET=true
WS_SHARD_SIZE=200
WS_INITIAL_SNAPSHOT_TIMEOUT_MS=0
WS_MIN_SNAPSHOT_COVERAGE_PCT=0.90
WS_QUOTE_MAX_AGE_MS=1000
WS_MARKET_DATA_SILENCE_TIMEOUT_MS=2500
MIN_CLOB_QUOTE_COVERAGE_PCT=1.00
MAX_SIGNAL_AGE_SECONDS=5
EVENT_LIFECYCLE_GATE_ENABLED=true
EVENT_LIFECYCLE_PRE_CUTOFF_BUFFER_SECONDS=300
ENABLE_GAMMA_FALLBACK_WHEN_NO_CLOB_EDGE=false
EXECUTE_ONLY_FULL_CLOB_PRICES=true
ALLOW_AUGMENTED_NEG_RISK=false
ENABLE_BUNDLE_SCANNING_ALL_EVENTS=true
ENABLE_RANKED_ARBITRAGE=false
# Read-only route discovery for future atomic Combo/RFQ execution support.
COMBO_RFQ_DISCOVERY_ENABLED=true
COMBO_RFQ_MAX_MARKETS=500
# Beta requester execution. Keep false unless beta access and accept/finality flow
# have been verified against Polymarket Combo API docs and live diagnostics.
COMBO_RFQ_REQUESTER_ENABLED=false
COMBO_RFQ_ACCEPT_ENABLED=false
COMBO_RFQ_REQUESTER_PROTOCOL_VERIFIED=false
# COMBO_RFQ_REQUESTER_API_URL=https://api.polymarket.us
# COMBO_RFQ_BEARER_TOKEN=
# COMBO_RFQ_PARTICIPANT_ID=
COMBO_RFQ_QUOTE_MAX_AGE_MS=400
COMBO_RFQ_MICROPRICE_ADVERSE_BPS=1.0
COMBO_RFQ_MARKOUT_RACE_SCORE_HORIZON_MS=250
COMBO_RFQ_MARKOUT_RACE_MIN_SAMPLES=3
COMBO_RFQ_MARKOUT_RACE_MAX_AGE_SECS=3600
COMBO_RFQ_MARKOUT_RACE_MAX_ADVERSE_BPS=1.0
# Required for live Combo/RFQ promotion after operator verification.
COMBO_RFQ_EXCHANGE_V3_ADDRESS=0xe3333700cA9d93003F00f0F71f8515005F6c00Aa
COMBO_RFQ_FINALITY_MAX_AGE_SECS=300
COMBO_RFQ_FINALITY_MIN_CONFIRMED_SAMPLES=3
COMBO_RFQ_COUNTERPARTY_MIN_SETTLEMENT_SAMPLES=3
COMBO_RFQ_STREAM_ENABLED=false
# COMBO_RFQ_GATEWAY_WSS_URL=wss://combos-rfq-gateway-quoter.polymarket.sh/ws/rfq
# COMBO_RFQ_GRPC_URL=
# COMBO_RFQ_STREAM_BEARER_TOKEN=
COMBO_RFQ_STREAM_RECONNECT_BACKOFF_MS=1000
# Ranked-style families are deprioritized in NO/bundle scanning unless ranked mode is enabled.
MAX_OPPORTUNITY_LEGS=15
OPPORTUNITY_DEDUPE_COOLDOWN_SECONDS=300

# Scan-time quote / universe budgets
# These keep scans fast and avoid broad /book bursts that cause 429s.
# - neg-risk budget controls how many whole neg-risk events are actively scanned per pass;
# - bundle budget controls how many single-market bundle candidates are actively scanned per pass;
# - quote budget controls how many token books can be REST-refreshed each scan after cache/WS reuse;
# - deferred_by_budget in logs is expected when the total universe is larger than the active scan slice;
# - WebSocket changes wake the scanner immediately; this interval caps idle polling when books do not change.
CLOB_MAX_CONCURRENCY=4
CLOB_BOOK_BATCH_SIZE=150
CLOB_BOOK_BATCH_PAUSE_MS=0
QUOTE_REFRESH_TOKEN_BUDGET_PER_SCAN=320
# The active slice should stay close to the REST refresh budget so the WS cache can warm.
# The effective cap is min(ACTIVE_QUOTE_TOKEN_BUDGET_PER_SCAN, QUOTE_REFRESH_TOKEN_BUDGET_PER_SCAN * ACTIVE_SLICE_TOKEN_BUDGET_MULTIPLIER).
ACTIVE_SLICE_TOKEN_BUDGET_MULTIPLIER=2
ACTIVE_QUOTE_TOKEN_BUDGET_PER_SCAN=640
SCAN_NEG_RISK_EVENT_BUDGET=96
SCAN_BUNDLE_EVENT_BUDGET=240
SCAN_ROTATION_PERIOD_SCANS=4
SELECTION_STICKY_FRACTION=0.35
CAPITAL_VELOCITY_RANKING_ENABLED=true
CAPITAL_VELOCITY_REFERENCE_HOURS=24
CAPITAL_VELOCITY_SCORE_WEIGHT=20000
QUOTE_SHORTFALL_SAMPLE_SIZE=8

# Fee model fallback (used only when per-market fee metadata is absent)
GAS_FALLBACK_USD=0.05
# FEE_THETA_DEFAULT=0.050

# Paper trading
PAPER_TRADING_ENABLED=true
PAPER_TRADE_POSITION_SIZE_USD=25
PAPER_MATCH_LIVE_POSITION_SIZE=true
PAPER_REQUIRE_FULL_CLOB_QUOTES=true
PAPER_USE_LIMIT_ORDERS=true
PAPER_MAX_SHARE_MISMATCH_PCT=0.50
# PAPER_TRADE_HISTORY_LIMIT=10000

# Persistent campaign evidence consumed by scripts/trade-readiness.sh.
# PAPER_PROFITABILITY_TRADES_CSV=paper_campaign/diagnostics/trades.csv
# PAPER_PROFITABILITY_ATTEMPTS_JSONL=paper_campaign/diagnostics/paper_execution_attempts.jsonl
PAPER_PROFIT_MIN_TRADES=100
PAPER_PROFIT_MIN_UNIQUE_EVENTS=30
PAPER_PROFIT_MIN_OBSERVATION_HOURS=168
PAPER_PROFIT_MAX_EVIDENCE_AGE_HOURS=24
PAPER_PROFIT_MIN_TOTAL_PNL_USD=25
PAPER_PROFIT_MIN_WEIGHTED_ROI_PCT=0.25
PAPER_PROFIT_MIN_LOWER_MEAN_PNL_USD=0
PAPER_PROFIT_MIN_EVENT_LOWER_MEAN_PNL_USD=0
PAPER_PROFIT_MIN_FILL_SUCCESS_RATE=0.80
PAPER_PROFIT_MIN_POSITIVE_TRADE_RATE=0.80
PAPER_PROFIT_MAX_DRAWDOWN_USD=25
PAPER_PROFIT_MAX_UNHEDGED_NOTIONAL_USD=0

# Dry-run provider: external (pm-trader)
DRY_RUN_PROVIDER=external

# Strategy lab / parallel paper-testing
STRATEGY_LAB_ENABLED=true
STRATEGY_LAB_REFRESH_INTERVAL_SECONDS=30
STRATEGY_LAB_MARKET_LIMIT=500
STRATEGY_LAB_INITIAL_CAPITAL_USD=10000
STRATEGY_LAB_POSITION_SIZE_USD=25
STRATEGY_LAB_MAX_POSITIONS_PER_STRATEGY=4
STRATEGY_LAB_CANDIDATE_CAP_PER_STRATEGY=24

# External dry-run engine (polymarket-paper-trader / pm-trader)
EXTERNAL_PAPER_COMMAND=pm-trader
EXTERNAL_PAPER_DATA_DIR=.pm-trader-scanner
EXTERNAL_PAPER_ACCOUNT=arb-scanner
EXTERNAL_PAPER_INIT_BALANCE_USD=10000
EXTERNAL_PAPER_ORDER_TYPE=fok
EXTERNAL_PAPER_LIMIT_ORDER_TYPE=gtc
EXTERNAL_PAPER_MIN_ORDER_USD=1.0
# PAPER_CANARY_MARKET_LIMIT=80

# Live execution (disabled by default)
LIVE_TRADING_ENABLED=false
LIVE_DIAGNOSTICS_ENABLED=false
LIVE_COMBO_RFQ_ROUTE_ENABLED=false
LIVE_ROUTE_CALIBRATION_MIN_SAMPLES=100
LIVE_ROUTE_CALIBRATION_MAX_AGE_SECS=300
POLYMARKET_STATUS_API_URL=https://status.polymarket.com/v3/summary.json
POLYMARKET_STATUS_COMPONENTS_API_URL=https://status.polymarket.com/v3/components.json
LIVE_STATUS_PAGE_ENABLED=true
LIVE_ACCOUNTING_SNAPSHOT_ENABLED=true
LIVE_ACCOUNTING_SNAPSHOT_MAX_POSITION_ROWS=0
LIVE_TRADE_POSITION_SIZE_USD=25
LIVE_CHAIN_ID=137
# 0=EOA, 1=Proxy, 2=Safe, 3=Poly1271 deposit wallet.
LIVE_SIGNATURE_TYPE=0
# Required when LIVE_SIGNATURE_TYPE is 1, 2, or 3.
# LIVE_FUNDER_ADDRESS=0xYourPolymarketFunderAddress
# Required for LIVE_SIGNATURE_TYPE=3 Deposit Wallet Combo closeout.
RELAYER_API_URL=https://relayer-v2.polymarket.com
# RELAYER_API_KEY=your-relayer-api-key
# RELAYER_API_KEY_ADDRESS=0xYourRelayerApiKeyAddress
RELAYER_WALLET_DEADLINE_SECONDS=300
LIVE_SLIPPAGE_BPS=10
LIVE_CLOB_MICROPRICE_ADVERSE_BPS=1.0
LIVE_FILL_POLL_TIMEOUT_SECONDS=30
LIVE_FILL_POLL_INTERVAL_MS=500
LIVE_MAX_REFRESH_TO_SUBMIT_MS=1000
LIVE_MAX_SERVER_CLOCK_UNCERTAINTY_MS=250
LIVE_MAX_SERVER_CLOCK_OFFSET_MS=5000
LIVE_STATUS_PAGE_MAINTENANCE_PREHALT_SECS=1800
LIVE_GAME_START_QUARANTINE_SECS=300
LIVE_MIN_LEG_SIZE_USD=1.0
LIVE_MAX_EVENT_EXPOSURE_USD=200.0
LIVE_MAX_TOTAL_EXPOSURE_USD=1000.0
LIVE_CANCEL_ON_FILL_TIMEOUT=true
# Destructive: when true, selected live kill-switch hazards call CLOB cancel-all for this account.
LIVE_CANCEL_ALL_ON_KILL_SWITCH=false
LIVE_ORDER_TYPE=fok
# Required when LIVE_TRADING_ENABLED=true; live execution fails closed without
# a fresh authenticated user-channel connection and API credentials.
LIVE_USER_WS_ENABLED=false
LIVE_PRE_SUBMIT_HEARTBEAT_ENABLED=true
LIVE_PRE_SUBMIT_HEARTBEAT_TIMEOUT_MS=750
LIVE_EDGE_HAIRCUT_USD=0.01
LIVE_EDGE_HAIRCUT_BPS=5
# Automatic Combo closeout execution supports EOA direct Router and Deposit Wallet Relayer.
# Proxy/safe closeout requires wallet-specific Relayer submission not enabled here.
LIVE_CLOSEOUT_ENABLED=false
LIVE_CLOSEOUT_DRY_RUN=true
LIVE_CLOSEOUT_MAX_ACTIONS_PER_RUN=10
LIVE_CLOSEOUT_CONFIRM_TIMEOUT_SECONDS=120
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_FINALIZED_BLOCK_MAX_LAG_BLOCKS=512
ONCHAIN_ORDER_FILLED_COLLECTOR_ENABLED=false
ONCHAIN_ORDER_FILLED_COLLECTOR_LOOKBACK_BLOCKS=512
SETTLEMENT_MONITOR_ENABLED=false
SETTLEMENT_REVERT_HAZARD_MIN_SAMPLES=10
SETTLEMENT_REVERT_HAZARD_MAX_RATE=0.0
SETTLEMENT_RECEIPT_MAX_AGE_SECONDS=86400
ORDER_SIZE_STEP_SHARES=0.0001
VALIDATE_OPPORTUNITIES_AT_TARGET_SIZE=true
ASSUME_GASLESS_FOR_PROXY_SIGNATURE_TYPES=false

# Polymarket Rust SDK auth input (required for live execution)
# POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
# Authenticated CLOB REST/user-channel credentials. Keep these out of source control.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# RFQ stream credentials, when separately provisioned.
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASS_PHRASE=
# CLOB_PASSPHRASE=
# The latter is accepted as an alias for CLOB_PASS_PHRASE.
# LIVE_SIGNER_ADDRESS=0xYourSignerAddress

# Notifications (optional)
# WEBHOOK_URL=https://discord.com/api/webhooks/...

# Operator console / diagnostics
VERBOSE_SCAN_LOGS=false
DIAGNOSTICS_CSV_ENABLED=true
DIAGNOSTICS_DIR=runtime_diagnostics
# High-volume CSVs keep current plus one previous generation. trades.csv never rotates.
DIAGNOSTICS_CSV_MAX_BYTES=104857600
# Noisy forensic streams; leave disabled for normal operation.
DIAGNOSTICS_LOG_ALL_CANDIDATE_EVALUATIONS=false
DIAGNOSTICS_LOG_ROUTINE_REJECTIONS=false
# Dashboard-controlled paper starts have no build fallback. Set all three to canonical
# paths from the same completed readiness run before pressing Start.
# SCANNER_RELEASE_BINARY=/absolute/readiness-run/release/polymarket-arb-scanner
# SCANNER_READINESS_MANIFEST=/absolute/readiness-run/readiness-bundle-manifest.json
# SCANNER_BUILD_PROVENANCE=/absolute/readiness-run/build-provenance.json
# ACTIVATION_PACKET_PATH=/absolute/activation-run/live-activation-packet.json

# Logging
LOG_LEVEL=info
# RUST_LOG=polymarket_arb_scanner=debug

# Retry / resilience
MAX_RETRIES=3
RETRY_BACKOFF_BASE_MS=1000
